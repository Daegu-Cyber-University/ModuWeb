# Copy this file to `.env` and fill in values. `.env` is gitignored.
#
# After editing, run: npm run config:from-env
# This writes config.json from config.example.json plus the variables below.
# At least one of WAT_DICTIONARY_ENDPOINT, WAT_DICTIONARY_TIMEOUT, WAT_COPYRIGHT_URL must be set.

# Required for dictionary: JSONP endpoint URL (see README — 사전 API(JSONP) 계약)
WAT_DICTIONARY_ENDPOINT=

# Optional: request timeout in milliseconds
# WAT_DICTIONARY_TIMEOUT=5000

# Optional: override branding.copyrightUrl in config.json
# WAT_COPYRIGHT_URL=https://www.example.com

# Optional: output path (default: ./config.json). Relative paths are from project root.
# WAT_CONFIG_OUTPUT=config.json
