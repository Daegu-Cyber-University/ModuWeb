# ============================================================
#  ModuWeb 설정 환경 변수 — 이 파일을 `.env`로 복사해 값 채우기
#  (`.env`는 gitignore 되어 커밋되지 않습니다)
# ============================================================
#
#  ⚠️ 보안 주의
#  아래 변수들은 전부 config.json 으로 들어가며, config.json 은
#  운영 사이트에서 브라우저가 그대로 내려받는 **공개 파일**입니다.
#  → 비밀키·토큰·패스워드는 절대 넣지 마세요. (변수명에 API_KEY /
#    SECRET / TOKEN 등이 보이면 생성 스크립트가 거부합니다.)
#  → 외부 API 키는 서버 프록시(serverEndpoint 패턴) 안에서만 사용하고,
#    여기에는 그 프록시의 URL만 둡니다. (README "사전 API 계약" 참고)
#
#  사용법
#    1) cp .env.example .env  (Windows: copy .env.example .env)
#    2) 값 채우기
#    3) npm run config:from-env   ← 수동 생성
#       또는 그냥 npm run build   ← 빌드 시 자동 생성(변수 있을 때만)
#
#  새 항목 추가: scripts/write-config-from-env.mjs 의 MAPPINGS 테이블에
#  한 줄 추가하면 됩니다.

# ── 사전(Dictionary) ─────────────────────────────────────────
# 사전 검색 서버 프록시 URL → api.dictionary.serverEndpoint
# (런타임은 https 만 허용합니다)
WAT_DICTIONARY_ENDPOINT=

# 사전 기능 켬/끔 (true/false) → api.dictionary.enabled
# 생략 시 serverEndpoint 존재 여부로 자동 판단됩니다
# WAT_DICTIONARY_ENABLED=true

# 사전 요청 타임아웃(ms, 양수) → api.dictionary.timeout
# WAT_DICTIONARY_TIMEOUT=5000

# ── 웹폰트 URL ───────────────────────────────────────────────
# 각 폰트의 CSS URL → resources.fonts.*  (http/https만)
# WAT_FONT_NANUM_MYEONGJO=https://fonts.googleapis.com/css2?family=Nanum+Myeongjo&display=swap
# WAT_FONT_NOTO_SERIF_KR=https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;700&display=swap
# WAT_FONT_KODDI_UD_GOTHIC=

# ── 브랜딩 ──────────────────────────────────────────────────
# 저작권 표기 링크 → branding.copyrightUrl
# WAT_COPYRIGHT_URL=https://www.example.com

# ── UI ──────────────────────────────────────────────────────
# 사전 모달 최대 폭(px, 양수) → settings.ui.modalWidth
# WAT_MODAL_WIDTH=600

# 사전 발음 표기 여부 (true/false) → settings.ui.showPronunciation
# WAT_SHOW_PRONUNCIATION=true

# ── 미래 슬롯 (아직 코드 미소비 — 예약) ──────────────────────
# 클라우드 TTS를 붙일 때: 서버 프록시 URL만! (키 자체 금지)
# WAT_TTS_ENDPOINT=            → api.tts.serverEndpoint (추후 지원)
# 번역 기능을 붙일 때: 서버 프록시 URL만! (키 자체 금지)
# WAT_TRANSLATION_ENDPOINT=    → api.translation.serverEndpoint (추후 지원)

# ── 메타 ────────────────────────────────────────────────────
# 출력 경로 (기본: ./config.json, 상대 경로는 프로젝트 루트 기준)
# WAT_CONFIG_OUTPUT=config.json
